# @YOKE_PROGRAM@ as it travels: a Python Plugin enters an application as a containerised unit.
FROM docker.io/library/python:3.13-slim@sha256:48d884813cf44e927cf64c5529dd630dd3b18338c6dc727991eef9b71e934a20
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY main.py /app/main.py
ENTRYPOINT ["python", "/app/main.py"]
